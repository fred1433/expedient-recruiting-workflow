# Copy to .env and replace every value. .env is git-ignored.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string
POSTGRES_PASSWORD=replace-me
POLL_TRIGGER_TOKEN=replace-me
# Test-bench values. In docker-compose.yml the defaults are LEASE_SECONDS=300, MAX_ATTEMPTS=5, RETRY_BASE_SECONDS=30.
LEASE_SECONDS=45
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2
# Small pages on the bench so every run exercises pagination.
SEARCH_PAGE_SIZE=2
ASSOC_PAGE_SIZE=1
